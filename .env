# ============================================================
#  Store Intelligence System - Environment Configuration
# ============================================================

# --- Application ---
APP_NAME=store-intelligence-system
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Video Source (default = Camera 1) ---
# Other cameras are launched via run_all_cameras.bat
VIDEO_SOURCE=data/CAM1.mp4
CAMERA_ID=CAM_001
STORE_ID=STORE_001

# --- Detection ---
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
TARGET_CLASSES=0

# --- Tracking ---
MAX_AGE=30
N_INIT=3
MAX_IOU_DISTANCE=0.7

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DETECTIONS=store.detections
KAFKA_TOPIC_ANALYTICS=store.analytics
KAFKA_TOPIC_ANOMALIES=store.anomalies
KAFKA_GROUP_ID=store-intelligence-consumer

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=store_intelligence
DB_USER=postgres
DB_PASSWORD=postgres123
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/store_intelligence

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# --- Dashboard ---
DASHBOARD_PORT=8501

# --- Anomaly Detection ---
LOITER_THRESHOLD_SECONDS=60
OVERCROWDING_THRESHOLD=20
SPEED_ANOMALY_THRESHOLD=150
ZONE_DWELL_ALERT_SECONDS=300

# --- Prometheus ---
METRICS_PORT=9090
