# ── Kafka ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DETECTIONS=store.detections
KAFKA_TOPIC_ANALYTICS=store.analytics
KAFKA_TOPIC_ANOMALIES=store.anomalies
KAFKA_CONSUMER_GROUP=store-intelligence
KAFKA_AUTO_OFFSET_RESET=latest

# ── PostgreSQL ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://store_user:store_password@localhost:5432/store_intelligence
DATABASE_POOL_SIZE=10

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# ── API ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_SECRET_KEY=change-this-in-production-use-strong-random-key

# ── Detection Pipeline ────────────────────────────────────────────
VIDEO_SOURCE=data/sample.mp4
CAMERA_ID=CAM_001
STORE_ID=STORE_001
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.5
DETECTION_DEVICE=cpu
FRAME_SKIP=2

# ── Anomaly Thresholds ────────────────────────────────────────────
LOITERING_THRESHOLD_SECONDS=30
CROWD_THRESHOLD=10
SPEED_ANOMALY_MULTIPLIER=3.0
DWELL_TIME_THRESHOLD=120

# ── Dashboard ─────────────────────────────────────────────────────
DASHBOARD_PORT=8501

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/store_intelligence.log